generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String              @id
  name          String
  email         String              @unique
  emailVerified Boolean             @default(false)
  image         String?
  role          Role                @default(USER)
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  accounts      Account[]
  sessions      Session[]

  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}


enum Role {
  USER
  ADMIN
}

model PREvaluation {
  id        String   @id @default(cuid())
  owner     String
  repo      String
  prNumber  Int
  headSha   String?
  impactedTests String[]
  skippedTests  String[]
  changedFiles  Json?


  testsRun     Int?
  testsFailed  Int?
  timeSaved    String?

  // AI-generated test suggestions
  suggestedTests Json?         // Array of { filename, content, description }
  generatedTestPR GeneratedTestPR?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([owner, repo, prNumber, headSha])
  @@index([owner, repo, prNumber])
}

model GeneratedTestPR {
  id              String   @id @default(cuid())
  evaluationId    String   @unique
  evaluation      PREvaluation @relation(fields: [evaluationId], references: [id], onDelete: Cascade)

  owner           String
  repo            String
  prNumber        Int       // The new PR number for the generated tests
  branchName      String
  status          String    @default("pending") // pending, created, merged, closed
  testsGenerated  Int       @default(0)
  prUrl           String?

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([owner, repo])
}

model RepoIndex {
  id        String   @id @default(cuid())
  owner     String
  repo      String
  testFiles String[]
  lastIndexedAt DateTime @default(now())

  @@unique([owner, repo])
}
